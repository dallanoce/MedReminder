<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and below use these rules for both cloud backup and device transfer, so nothing is
   backed up there: the therapy plan is health data and never leaves the device in a cloud backup.
   Android 12+ uses data_extraction_rules.xml instead.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
